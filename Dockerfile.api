# The Strata API on synthetic data. The image builds the public workspace once (synthetic extract,
# warehouse, claims, simulator inputs and models) so that `docker compose up` serves at once; the
# alert queue is stored in PostgreSQL at start-up by docker/api-entrypoint.sh. The empty model
# registry folder lets the MLflow UI open the shared, read-only run store.
FROM python:3.12.10-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    PYTENSOR_FLAGS=cxx= \
    MLFLOW_ALLOW_FILE_STORE=true \
    MLFLOW_DISABLE_AGENT_HINT=1 \
    STRATA_WORK_DIR=/data/work \
    STRATA_DB=/data/work/strata.duckdb \
    PATH="/app/.venv/bin:${PATH}"

# LightGBM needs the OpenMP runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 strata \
    && mkdir -p /app /data/work \
    && chown -R strata /app /data

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv

USER strata
WORKDIR /app

COPY --chown=strata pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY --chown=strata strata ./strata
COPY --chown=strata dbt ./dbt
COPY --chown=strata mappings ./mappings
COPY --chown=strata docs/ledger ./docs/ledger
RUN uv sync --frozen --no-dev

RUN strata synth --out /data/work/synth \
    && strata ingest --data-dir /data/work/synth \
    && strata dq \
    && strata dbt build \
    && strata ledger build --quick \
    && strata analyse markov --quick \
    && strata train all --quick \
    && mkdir -p /data/work/mlruns/models

COPY --chown=strata docker/api-entrypoint.sh /app/docker/api-entrypoint.sh

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"
ENTRYPOINT ["sh", "/app/docker/api-entrypoint.sh"]
