root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,js,ts,tsx,jsx,css,html,md,j2,sql}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for hard breaks; we never rely on them, so trimming is safe.
trim_trailing_whitespace = true

[justfile]
indent_size = 4

[legacy/**]
# Frozen code keeps whatever it had.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
