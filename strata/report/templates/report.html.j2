<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Strata {{ variant }} report</title>
<style>
  :root {
    --bg: #fbfbfa; --surface: #ffffff; --ink: #1f2933; --muted: #616e7c; --line: #e4e7eb;
    --accent: #2f6f9f; --holds: #2f7d4f; --weakens: #a86b00; --reverses: #b23b3b;
    --banner: #fff4d6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12161b; --surface: #1a2027; --ink: #e4e7eb; --muted: #9aa5b1; --line: #2d3640;
      --accent: #7fb2d8; --holds: #6cc08b; --weakens: #e0b050; --reverses: #f08080;
      --banner: #3a3220;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 980px; margin: 0 auto; padding: 24px 16px 64px; }
  h1 { font-size: 26px; margin: 8px 0 4px; }
  h2 { font-size: 20px; margin: 40px 0 8px; border-bottom: 1px solid var(--line); padding-bottom: 6px; }
  h3 { font-size: 17px; margin: 0 0 4px; }
  .meta, .question { color: var(--muted); }
  .banner { background: var(--banner); padding: 10px 14px; border-radius: 6px; margin: 12px 0; }
  .claim { background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
           padding: 16px; margin: 16px 0; }
  .badge { display: inline-block; font-size: 12px; font-weight: 600; padding: 2px 8px;
           border-radius: 999px; border: 1px solid currentColor; margin-left: 8px; }
  .badge.holds { color: var(--holds); } .badge.weakens { color: var(--weakens); }
  .badge.reverses { color: var(--reverses); } .badge.insufficient { color: var(--muted); }
  .badge.headline { color: var(--accent); }
  table { border-collapse: collapse; width: 100%; margin: 8px 0; font-size: 14px; }
  th, td { text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; }
  .scroll { overflow-x: auto; }
  details { margin-top: 8px; }
  code { font-size: 13px; }
</style>
<script>{{ plotly_js | safe }}</script>
</head>
<body>
<main>
  <h1>Strata {{ variant }} report</h1>
  <p class="meta">Generated {{ generated }} by strata {{ version }}.
  {% if variant == "private" %}Private: every claim on the real extract. Do not share outside the machine.{% endif %}</p>

  {% for section in sections %}
  <h2>{{ section.title }}</h2>
  <div class="banner">{{ section.banner }}</div>
  <p class="meta">Data fingerprint <code>{{ section.ledger.data_fingerprint[:16] }}</code>,
     computed {{ section.ledger.computed_at.isoformat() }}, {{ section.ledger.claims | length }} claims.</p>

  {% for record in ordered(section.ledger) %}
  <section class="claim" id="{{ section.ledger.source_kind }}-{{ record.id }}">
    <h3>{{ record.title }}
      {% if record.headline %}<span class="badge headline">headline</span>{% endif %}
      {% if record.robustness %}<span class="badge {{ record.robustness.verdict }}">{{ record.robustness.verdict }}</span>{% endif %}
    </h3>
    <p class="question">{{ record.question }}</p>
    <p class="meta"><code>{{ record.id }}</code> · {{ record.n }} clients{% if record.n_events %} · {{ record.n_events }} events{% endif %} · {{ record.source_kind }} data</p>
    <div class="scroll">
    <table>
      <thead><tr><th>Value</th><th>Estimate</th><th>Interval</th><th>Clients</th></tr></thead>
      <tbody>
      {% for key in record.values %}
        <tr><td>{{ key.replace("_", " ") }}</td><td>{{ value(record, key) }}</td><td>{{ interval(record, key) }}</td><td>{{ clients(record, key) }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% for figure in figures(record) %}{{ figure | safe }}{% endfor %}
    {% if record.robustness %}
    <p><strong>Robustness ({{ record.robustness.verdict }}).</strong> {{ record.robustness.mechanism }}</p>
    <details><summary>Strata</summary>
      <div class="scroll">
      <table>
        <thead><tr><th>Stratifier</th><th>Stratum</th><th>Effect</th><th>Interval</th><th>Treatment</th><th>Reference</th><th>Used</th></tr></thead>
        <tbody>
        {% for stratifier in record.robustness.stratifiers %}
          {% for stratum in stratifier.strata %}
          <tr><td>{{ stratifier.stratifier }}</td><td>{{ stratum.stratum }}</td>
              <td>{{ "%+.1f points" % (100 * stratum.effect) if stratum.effect is not none else "" }}</td>
              <td>{{ "%+.1f to %+.1f" % (100 * stratum.ci[0], 100 * stratum.ci[1]) if stratum.ci else "" }}</td>
              <td>{{ stratum.n_treatment }}</td><td>{{ stratum.n_reference }}</td>
              <td>{{ "yes" if stratum.sufficient else "no" }}</td></tr>
          {% endfor %}
          <tr><td>{{ stratifier.stratifier }}</td><td><em>adjusted</em></td>
              <td>{{ "%+.1f points" % (100 * stratifier.adjusted_effect) if stratifier.adjusted_effect is not none else "" }}</td>
              <td>{{ "%+.1f to %+.1f" % (100 * stratifier.adjusted_ci[0], 100 * stratifier.adjusted_ci[1]) if stratifier.adjusted_ci else "" }}</td>
              <td colspan="3">{{ "sign reverses" if stratifier.reverses else "" }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
    </details>
    {% endif %}
    <details><summary>Method and caveats</summary>
      <p>{{ record.method }}</p>
      <ul>{% for caveat in record.caveats %}<li>{{ caveat }}</li>{% endfor %}</ul>
      {% if record.meta %}<p class="meta">{% for key, text in record.meta.items() if not key.startswith("rows_") %}{{ key.replace("_", " ") }}: {{ text }}{{ "; " if not loop.last }}{% endfor %}</p>{% endif %}
    </details>
  </section>
  {% endfor %}
  {% endfor %}
</main>
</body>
</html>
