# The dashboard: built with pnpm (the version pinned in package.json, through corepack) and served
# by nginx, which also proxies /api/ to the API container so the browser talks to one origin. The
# build fails if the bundle carries data (scripts/check-bundle.mjs reads the public ledger copied
# below, only to make sure none of its values is baked into the bundle).
FROM node:22.12.0-alpine AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=true
RUN corepack enable
WORKDIR /app
COPY apps/dashboard/package.json apps/dashboard/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/dashboard/ ./
COPY docs/ledger/claims.public.json /docs/ledger/claims.public.json
RUN pnpm build

FROM nginx:1.27.3-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
